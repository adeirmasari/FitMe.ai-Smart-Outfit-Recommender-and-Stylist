# Copy to .env (never commit .env). Real environment variables override this file.

# --- Django ---
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate: python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://fitme.example.com

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://fitme@localhost:5432/fitme

# --- AI provider ---
# qwen  = real Qwen2.5-VL via an OpenAI-compatible endpoint
# mock  = development fixture (refused when DJANGO_DEBUG=false), clearly labelled in the UI
# none  = analysis disabled (API returns 503)
AI_PROVIDER=qwen

# Qwen2.5-VL endpoint — pick ONE option:
#  Alibaba Cloud Model Studio (DashScope, international):
#   QWEN_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   QWEN_MODEL=qwen2.5-vl-72b-instruct
#  OpenRouter:
#   QWEN_API_BASE=https://openrouter.ai/api/v1
#   QWEN_MODEL=qwen/qwen2.5-vl-72b-instruct
#  Self-hosted vLLM:  vllm serve Qwen/Qwen2.5-VL-7B-Instruct --port 8001
#   QWEN_API_BASE=http://localhost:8001/v1
#   QWEN_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
#  Ollama:  ollama pull qwen2.5vl:7b
#   QWEN_API_BASE=http://localhost:11434/v1
#   QWEN_MODEL=qwen2.5vl:7b
QWEN_API_BASE=https://router.huggingface.co/v1
QWEN_API_KEY=
QWEN_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
QWEN_TIMEOUT_SECONDS=60
QWEN_CONNECT_TIMEOUT_SECONDS=10
QWEN_MAX_TOKENS=1200
QWEN_TEMPERATURE=0.2
QWEN_TOP_P=0.9
# Set false if your server rejects response_format=json_object (some Ollama/vLLM builds)
QWEN_JSON_MODE=true
QWEN_MAX_RETRIES=1

# --- Limits (optional) ---
# FITME_MAX_UPLOAD_BYTES=8388608
# FITME_THROTTLE_AUTH=10/min
# FITME_THROTTLE_REFRESH=60/min
# FITME_THROTTLE_ANALYSIS=20/hour
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=7
